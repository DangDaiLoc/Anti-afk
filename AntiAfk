local function save(o,p)
    saved[o]=saved[o] or {}
    if saved[o][p]==nil then
        local ok,v=pcall(function() return o[p] end)
        if ok then saved[o][p]=v end
    end
end

local function optimize(o)
    if not on then return end
    pcall(function()

        if effects and (
            o:IsA("ParticleEmitter") or
            o:IsA("Trail") or
            o:IsA("Beam") or
            o:IsA("Fire") or
            o:IsA("Smoke") or
            o:IsA("Sparkles")) then
            save(o,"Enabled")
            o.Enabled=false
        end

        if effects and (
            o:IsA("PointLight") or
            o:IsA("SpotLight") or
            o:IsA("SurfaceLight") or
            o:IsA("PostEffect")) then
            save(o,"Enabled")
            o.Enabled=false
        end

        if graphics and (o:IsA("Decal") or o:IsA("Texture"))
        and (mode=="Extreme" or mode=="Extreme+") then
            save(o,"Transparency")
            o.Transparency=1
        end

        if graphics and mode=="Extreme+" and
           o:IsA("SurfaceAppearance") then
            save(o,"Enabled")
            o.Enabled=false
        end
    end)
end

local function optimizeAll()
    if not on then return end

    pcall(function()
        settings().Rendering.QualityLevel=Enum.QualityLevel.Level01
        L.GlobalShadows=false
        L.FogEnd=1000000
    end)

    for _,o in ipairs(W:GetDescendants()) do optimize(o) end

    pcall(function()
        local t=W:FindFirstChildOfClass("Terrain")
        if t and world then
            t.WaterWaveSize=0
            t.WaterWaveSpeed=0
            t.WaterReflectance=0
            if mode=="Extreme+" then t.WaterTransparency=1 end
        end
    end)
end

local function restoreAll()
    for o,ps in pairs(saved) do
        for p,v in pairs(ps) do pcall(function() o[p]=v end) end
    end
    saved={}
end

local function setmode(x)
    mode=x
    status.Text="MODE: "..x
    if on then restoreAll();task.wait(.1);optimizeAll() end
end

