-- ===== Functions macro =====
local function stopAll()
    recording = false
    playing = false
    if connRecord then connRecord:Disconnect() connRecord = nil end
    if connPlay then connPlay:Disconnect() connPlay = nil end
end

local function startRecord()
    stopAll()
    recordedPath = {}
    recording = true
    recordStart = tick()
    connRecord = RunService.Heartbeat:Connect(function()
        if not recording then return end
        table.insert(recordedPath, { time = tick() - recordStart, cframe = rootPart.CFrame })
    end)
end

local function playPath()
    if #recordedPath < 2 then return end
    stopAll()
    playing = true
    task.spawn(function()
        repeat
            local startTime = tick()
            local index = 1
            while playing and index <= #recordedPath do
                local elapsed = tick() - startTime
                local point = recordedPath[index]
                if elapsed >= point.time then
                    rootPart.CFrame = point.cframe
                    index = index + 1
                end
                RunService.Heartbeat:Wait()
            end
            if looping and playing and loopDelay > 0 then
                task.wait(loopDelay)
            end
        until not looping or not playing
        playing = false
    end)
end

