local function getLocationsFolder()
    if W:FindFirstChild("Locations") then
        return W.Locations
    elseif W:FindFirstChild("_WorldOrigin") and W._WorldOrigin:FindFirstChild("Locations") then
        return W._WorldOrigin.Locations
    end
    return nil
end

local function updatePlayerESP(plr)
    if plr == P or not plr.Character then return end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if espActive then
        local bill = hrp:FindFirstChild("BF_ESP_Box")
        if not bill then
            bill = Instance.new("BillboardGui")
            bill.Name = "BF_ESP_Box"
            bill.Size = UDim2.new(0, 200, 0, 40)
            bill.StudsOffset = Vector3.new(0, 3.5, 0)
            bill.AlwaysOnTop = true
            bill.Parent = hrp

            local txt = Instance.new("TextLabel", bill)
            txt.Name = "ESPText"
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = Color3.fromRGB(255, 60, 60)
            txt.TextStrokeTransparency = 0
            txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            txt.TextSize = 13
            txt.Font = Enum.Font.SourceSansBold
            txt.Text = plr.DisplayName .. "\n[0m]"
        end
    else
        local bill = hrp:FindFirstChild("BF_ESP_Box")
        if bill then bill:Destroy() end
    end
end

local function updateIslandESP()
    local locFolder = getLocationsFolder()
    if not locFolder then return end

    for _, loc in ipairs(locFolder:GetChildren()) do
        local targetPart = loc:IsA("BasePart") and loc or (loc:IsA("Model") and (loc.PrimaryPart or loc:FindFirstChildWhichIsA("BasePart")))
        if targetPart then
            local bill = targetPart:FindFirstChild("BF_Island_ESP")
            if islandEspActive then
                if not bill then
                    bill = Instance.new("BillboardGui")
                    bill.Name = "BF_Island_ESP"
                    bill.Size = UDim2.new(0, 200, 0, 40)
                    bill.StudsOffset = Vector3.new(0, 10, 0)
                    bill.AlwaysOnTop = true
                    bill.Parent = targetPart

                    local txt = Instance.new("TextLabel", bill)
                    txt.Name = "ESPText"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = Color3.fromRGB(255, 60, 60)
                    txt.TextStrokeTransparency = 0
                    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    txt.TextSize = 13
                    txt.Font = Enum.Font.SourceSansBold
                    txt.Text = loc.Name .. "\n[0m]"
                end
            else
                if bill then bill:Destroy() end
            end
        end
    end
end

local function refreshAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do updatePlayerESP(plr) end
    updateIslandESP()
end

RunService.RenderStepped:Connect(function()
    local myChar = P.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if espActive and myHrp then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= P and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bill = hrp:FindFirstChild("BF_ESP_Box")
                    if bill then
                        local txt = bill:FindFirstChild("ESPText")
                        if txt then
                            local dist = math.floor((hrp.Position - myHrp.Position).Magnitude)
                            txt.Text = string.format("%s\n[%dm]", plr.DisplayName, dist)
                        end
                    else
                        updatePlayerESP(plr)
                    end
                end
            end
        end
    end

    if islandEspActive and myHrp then
        local locFolder = getLocationsFolder()
        if locFolder then
            for _, loc in ipairs(locFolder:GetChildren()) do
                local targetPart = loc:IsA("BasePart") and loc or (loc:IsA("Model") and (loc.PrimaryPart or loc:FindFirstChildWhichIsA("BasePart")))
                if targetPart then
                    local bill = targetPart:FindFirstChild("BF_Island_ESP")
                    if bill then
                        local txt = bill:FindFirstChild("ESPText")
                        if txt then
                            local dist = math.floor((targetPart.Position - myHrp.Position).Magnitude)
                            txt.Text = string.format("%s\n[%dm]", loc.Name, dist)
                        end
                    else
                        updateIslandESP()
                    end
                end
            end
        end
    end
end)

local function purgeVFX(v)
    if not active or v.Name == "BF_ESP_Box" or v.Name == "BF_Island_ESP" or v.Name == "BF_FPS_Counter" then return end
    pcall(function()
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Highlight") then
            v.Enabled = false; v:Destroy()
        elseif v:IsA("BasePart") then
            local n = v.Name:lower()
            local pName = v.Parent and v.Parent.Name:lower() or ""

            if n:find("effect") or n:find("haki") or pName:find("effect") then 
                v.Transparency = 1; v.Size = Vector3.new(0,0,0)
            else 
                v.Material = Enum.Material.SmoothPlastic 
            end

            if superFix then
                if n:find("tree") or n:find("leaf") or n:find("leaves") or n:find("trunk") 
                or n:find("branch") or n:find("wood") or n:find("bush") or n:find("grass") 
                or n:find("foliage") or n:find("plant") or n:find("rock")
                or pName:find("tree") or pName:find("plant") then
                    v.Transparency = 1
                end
            end
        end
    end)
end

local function applySuperFix()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        L.GlobalShadows = false; L.FogEnd = 9e9
        local t = W:FindFirstChildOfClass("Terrain")
        if t then t.WaterTransparency = 1; if superFix then t:Clear() end end
    end)
    for _, obj in ipairs(W:GetDescendants()) do purgeVFX(obj) end
end

