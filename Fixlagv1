-- Hàm diệt sạch VFX Võ, Trái, Súng, Haki
local function purgeVFX(v)
    if not active then return end
    pcall(function()
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") 
        or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") 
        or v:IsA("Explosion") or v:IsA("Highlight") or v:IsA("SelectionBox") then
            v.Enabled = false
            v:Destroy()
        end

        if v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
            v.Enabled = false
            v:Destroy()
        end

        if v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") 
        or v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") 
        or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
            v.Enabled = false
            v:Destroy()
        end

        if v:IsA("BasePart") then
            local name = v.Name:lower()
            local parentName = v.Parent and v.Parent.Name:lower() or ""

            if name:find("effect") or name:find("particle") or name:find("skill") 
            or name:find("haki") or name:find("aura") or name:find("blast") 
            or name:find("slash") or name:find("bullet") or name:find("shot")
            or parentName:find("effects") or parentName:find("haki") then
                v.Transparency = 1
                v.CastShadow = false
                v.Size = Vector3.new(0,0,0)
            else
                v.Material = Enum.Material.SmoothPlastic
                v.CastShadow = false
                v.Reflectance = 0
            end

            if superFix then
                if name:find("tree") or name:find("leaf") or name:find("grass") 
                or name:find("rock") or name:find("bush") or name:find("wood") then
                    v.Transparency = 1
                end
            end
        end

        if v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 1
            v:Destroy()
        end
    end)
end

-- Chế độ Siêu Cấp Fix Lag
local function applySuperFix()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        L.GlobalShadows = false
        L.FogEnd = 9e9
        L.Brightness = 1
        
        if superFix then
            L.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
            for _, v in ipairs(L:GetChildren()) do
                if v:IsA("Sky") then v:Destroy() end
            end
        end

        local t = W:FindFirstChildOfClass("Terrain")
        if t then
            t.WaterWaveSize = 0
            t.WaterWaveSpeed = 0
            t.WaterReflectance = 0
            t.WaterTransparency = 1
            if superFix then t:Clear() end
        end
    end)

    for _, obj in ipairs(W:GetDescendants()) do
        purgeVFX(obj)
    end
end

applySuperFix()

W.DescendantAdded:Connect(function(v)
    task.defer(function() purgeVFX(v) end)
end)

local function hookChar(char)
    if not char then return end
    char.DescendantAdded:Connect(function(v)
        task.defer(function() purgeVFX(v) end)
    end)
end
if P.Character then hookChar(P.Character) end
P.CharacterAdded:Connect(hookChar)

