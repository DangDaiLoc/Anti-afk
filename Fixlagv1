    scroll.Visible = false
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y -- [QUAN TRỌNG] Tự động giãn khung cuộn theo nội dung bên trong

    local layout = Instance.new("UIListLayout", scroll)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 10)

    local padding = Instance.new("UIPadding", scroll)
    padding.PaddingTop = UDim.new(0, 12)
    padding.PaddingLeft = UDim.new(0, 14)
    padding.PaddingRight = UDim.new(0, 14)
    padding.PaddingBottom = UDim.new(0, 12)

    tabs[name] = {btn = tabBtn, ind = indicator, scroll = scroll}

    tabBtn.MouseButton1Click:Connect(function()
        for tName, data in pairs(tabs) do
            data.btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            data.btn.TextColor3 = Color3.fromRGB(150, 150, 150)
            data.ind.Visible = false
            data.scroll.Visible = false
